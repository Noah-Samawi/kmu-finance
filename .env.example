# App-Verbindung: eingeschränkter DB-User kmu_app (NOBYPASSRLS – sonst greift RLS nicht!)
# Anlegen: APP_DB_PASSWORD=... npm run db:ensure-app-role
DATABASE_URL="postgresql://kmu_app:CHANGE_ME@localhost:5432/kmu_finance"
APP_DB_PASSWORD="CHANGE_ME"

# Migrationen & Seed: Owner-User (darf Tabellen anlegen; oft BYPASSRLS)
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kmu_finance"

# Ablage für Belege & Rechnungs-PDFs.
# Lokal: Dateisystem. Produktion (Vercel): Blob ODER S3 – sonst schlägt der Upload mit 503 fehl.
STORAGE_DIR="./storage"
# BLOB_READ_WRITE_TOKEN=""
# VERCEL_BLOB_READ_WRITE_TOKEN=""
# S3_BUCKET=""
# S3_REGION="eu-central-1"
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Öffentliche App-URL (Links in E-Mails: Freigabe, Passwort-Reset)
APP_URL="http://localhost:3000"

# E-Mail (optional): ohne RESEND_API_KEY werden Mails nur in die Konsole geloggt
# RESEND_API_KEY=""
# EMAIL_FROM="Kassenbuch <noreply@example.com>"

# HMAC für TOTP-Login-Challenge (sonst Fallback auf APP_URL / DATABASE_URL)
# TOTP_CHALLENGE_SECRET=""

# Session-Dauer in Tagen
SESSION_DAYS=14

# Seed-Zugang System-Inhaber (nur Entwicklung!)
SEED_SUPERADMIN_EMAIL="super@kmu.local"
SEED_SUPERADMIN_PASSWORD="Super123!"

# Nur lokal mit "next start" ohne HTTPS: Cookies ohne Secure-Flag
# INSECURE_COOKIES=1

# Google Gemini: KI-Belegerkennung (Foto/PDF → Buchungsvorschlag). Ohne Key: einfache Texterkennung im Browser.
# Key: https://aistudio.google.com/apikey – auf Vercel als Environment Variable hinterlegen.
GEMINI_API_KEY=""
# Optional: anderes Modell (Standard gemini-3.5-flash)
# GEMINI_MODEL="gemini-3.5-flash"
