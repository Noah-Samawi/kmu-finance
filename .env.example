# App-Verbindung: eingeschränkter DB-User (RLS greift nur für Nicht-Owner!)
DATABASE_URL="postgresql://kmu_app:kmu_app@localhost:5432/kmu_finance"

# Migrationen & Seed: Owner-User (darf Tabellen anlegen)
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kmu_finance"

# Ablage für Belege & Rechnungs-PDFs (lokal). Später durch S3/MinIO ersetzbar.
STORAGE_DIR="./storage"

# Session-Dauer in Tagen
SESSION_DAYS=14

# Seed-Zugang System-Inhaber (nur Entwicklung!)
SEED_SUPERADMIN_EMAIL="super@kmu.local"
SEED_SUPERADMIN_PASSWORD="Super123!"

# Nur lokal mit "next start" ohne HTTPS: Cookies ohne Secure-Flag
# INSECURE_COOKIES=1
